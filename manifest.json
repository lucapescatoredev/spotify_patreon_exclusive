{
  "manifest_version": 3,
  "name": "Spotify Exclusive Episodes Finder",
  "version": "1.0.0",
  "description": "Filter and search Patreon exclusive episodes on Spotify podcasts",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
